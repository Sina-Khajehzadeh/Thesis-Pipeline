{
  "extends": "base_config.example.json",
  "enabled": false,
  "template_only": false,
  "experiment_name": "Thesis_XGBoost_Budget_Local_GPU_TabPFN",
  "replace_scenarios": true,
  "budget_reference_model": "XGBoost",
  "models": {
    "TabPFN": {
      "execution": {
        "path": "local",
        "local_device": "cuda",
        "require_requested_device": true
      }
    },
    "XGBoost": {
      "execution": {
        "device": "cuda",
        "require_requested_device": true
      }
    }
  },
  "scenarios": {
    "Custom_XGB_Runtime_Budget_Name": {
      "semantic_role": "tuned_ml_runtime_reference",
      "budgeting": {
        "enabled": true,
        "cap_untuned_competitors": true
      },
      "budget_reference_model": "XGBoost",
      "enabled_models": [
        "TabPFN",
        "L-SLR",
        "Augmented_SLR",
        "RandomForest",
        "XGBoost",
        "CatBoost"
      ],
      "model_overrides": {}
    }
  }
}
