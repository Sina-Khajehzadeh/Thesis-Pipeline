{
  "dictionary_version": "1.0",
  "pipeline_version": "V14",
  "scope": "JSON configuration reference for binary tabular classification experiments.",
  "compatibility": {
    "supported_outcome": "Exactly two target classes mapped to 0 and 1.",
    "supported_data": "Tabular CSV, TSV, Parquet, Pickle, Feather, JSON, pandas DataFrame, or supported scikit-learn demonstration data.",
    "row_independence": "Use stratified splitting for independent rows and stratified_group splitting for repeated subjects.",
    "temporal_data": "Use temporal splitting when chronological order defines the test partition.",
    "outside_scope": [
      "multiclass classification",
      "regression"
    ]
  },
  "decision_rules": [
    {
      "question": "Are multiple rows from the same subject or entity present?",
      "if_yes": "Set data.group_column and splitting.strategy to stratified_group.",
      "if_no": "Set data.group_column to null and use stratified splitting unless time ordering is required."
    },
    {
      "question": "Must the test partition represent earlier or later observations?",
      "if_yes": "Set data.timestamp_column and splitting.strategy to temporal.",
      "if_no": "Use stratified or stratified_group splitting."
    },
    {
      "question": "Is the budget reference model tuned by Optuna?",
      "if_yes": "The reference budget is its dedicated Optuna tuning-loop runtime.",
      "if_no": "The configured reference execution runtime is used."
    },
    {
      "question": "Are optional model packages or CUDA unavailable?",
      "if_yes": "Disable those models or choose CPU/auto before the dry run.",
      "if_no": "Keep the requested model and device settings."
    }
  ],
  "sections": [
    {
      "name": "Study identity and experiment dimensions",
      "fields": [
        {
          "path": "extends",
          "type": "string or array of strings",
          "required": "No",
          "default": null,
          "allowed": "Relative or absolute JSON paths",
          "description": "Parent configuration file or files merged before the child configuration.",
          "example": "base_config.example.json"
        },
        {
          "path": "enabled",
          "type": "boolean",
          "required": "No",
          "default": true,
          "allowed": [true, false],
          "description": "Controls selection by --config-dir. An explicitly supplied --config can still be inspected.",
          "example": true
        },
        {
          "path": "template_only",
          "type": "boolean",
          "required": "No",
          "default": false,
          "allowed": [true, false],
          "description": "Marks documentation templates that --config-dir must skip.",
          "example": false
        },
        {
          "path": "experiment_name",
          "type": "string",
          "required": "Yes",
          "default": null,
          "allowed": "Any filesystem-safe descriptive label",
          "description": "Human-readable experiment identifier used in run folder names and manifests.",
          "example": "External_Cohort_Experiment"
        },
        {
          "path": "iterations",
          "type": "positive integer",
          "required": "Yes",
          "default": null,
          "allowed": "1 or greater",
          "description": "Number of sequential Monte Carlo iterations for each scenario and sample size.",
          "example": 15
        },
        {
          "path": "base_seed",
          "type": "integer",
          "required": "No",
          "default": 2025,
          "allowed": "Any reproducibly recorded integer",
          "description": "Starting seed from which iteration-specific seeds are derived.",
          "example": 2025
        },
        {
          "path": "sample_sizes",
          "type": "array",
          "required": "Yes unless total_n is supplied",
          "default": null,
          "allowed": "Positive integers and/or the string full",
          "description": "Requested sample sizes evaluated for every configured scenario.",
          "example": [100, 300, "full"]
        },
        {
          "path": "train_frac",
          "type": "number",
          "required": "No",
          "default": 0.8,
          "allowed": "Strictly between 0 and 1",
          "description": "Fraction assigned to the outer-training partition.",
          "example": 0.8
        },
        {
          "path": "inner_validation_frac",
          "type": "number",
          "required": "No",
          "default": 0.2,
          "allowed": "Strictly between 0 and 1",
          "description": "Fraction of outer-training data reserved for inner validation.",
          "example": 0.2
        }
      ]
    },
    {
      "name": "Data source, outcome, groups, and features",
      "fields": [
        {
          "path": "data.source",
          "type": "string path",
          "required": "One of source, dataframe, or sklearn_dataset",
          "default": null,
          "allowed": "CSV, TSV, Parquet, Pickle, Feather, or JSON file",
          "description": "Location of the tabular dataset. Keep confidential data outside Git.",
          "example": "data/analysis.parquet"
        },
        {
          "path": "data.dataframe",
          "type": "pandas DataFrame",
          "required": "Python API only; alternative to data.source",
          "default": null,
          "allowed": "In-memory DataFrame",
          "description": "Programmatic input for module use. It cannot be represented directly in JSON.",
          "example": "analysis_frame"
        },
        {
          "path": "data.sklearn_dataset",
          "type": "string",
          "required": "No",
          "default": null,
          "allowed": ["breast_cancer", "iris_binary", "wine_binary"],
          "description": "Small public dataset used for smoke tests rather than thesis evidence.",
          "example": "breast_cancer"
        },
        {
          "path": "data.dataset_identifier",
          "type": "string",
          "required": "Recommended",
          "default": null,
          "allowed": "Versioned non-sensitive identifier",
          "description": "Traceable dataset label stored in manifests without copying raw data.",
          "example": "cohort_release_2026_01"
        },
        {
          "path": "data.read_kwargs",
          "type": "object",
          "required": "No",
          "default": {},
          "allowed": "Keyword arguments accepted by the selected pandas reader",
          "description": "Reader-specific options such as delimiters, encodings, or column types.",
          "example": {
            "sep": ";",
            "encoding": "utf-8"
          }
        },
        {
          "path": "data.target",
          "type": "string",
          "required": "Yes unless target_fn is used through the Python API",
          "default": null,
          "allowed": "Existing outcome column",
          "description": "Binary outcome column. Rows with missing outcomes are removed.",
          "example": "outcome"
        },
        {
          "path": "data.positive_label",
          "type": "scalar",
          "required": "Recommended when the positive class is not already 1",
          "default": "Automatic detection",
          "allowed": "One of the two observed outcome values",
          "description": "Outcome value mapped to encoded class 1.",
          "example": "case"
        },
        {
          "path": "data.target_map",
          "type": "object",
          "required": "No",
          "default": null,
          "allowed": "Complete mapping of both target values to 0 and 1",
          "description": "Explicit binary encoding that overrides positive_label.",
          "example": {
            "control": 0,
            "case": 1
          }
        },
        {
          "path": "data.group_column",
          "type": "string or null",
          "required": "Required for grouped splitting",
          "default": null,
          "allowed": "Existing non-missing identifier column",
          "description": "Subject/entity identifier that prevents the same group appearing in training and test data.",
          "example": "patient_id"
        },
        {
          "path": "data.timestamp_column",
          "type": "string or null",
          "required": "Required for temporal splitting",
          "default": null,
          "allowed": "Existing chronologically sortable column",
          "description": "Time variable used to construct temporal partitions.",
          "example": "observation_time"
        },
        {
          "path": "data.feature_columns",
          "type": "array of strings or null",
          "required": "No",
          "default": null,
          "allowed": "Existing predictor columns",
          "description": "Explicit predictor allow-list. When null, eligible columns are inferred after exclusions.",
          "example": ["age", "marker_a", "marker_b"]
        },
        {
          "path": "data.drop_columns",
          "type": "array of strings",
          "required": "No",
          "default": [],
          "allowed": "Existing or intentionally absent columns",
          "description": "Identifiers, leakage variables, free text, and other excluded fields.",
          "example": ["record_id", "post_outcome_measure"]
        },
        {
          "path": "data.datetime_columns",
          "type": "array of strings",
          "required": "No",
          "default": [],
          "allowed": "Existing datetime columns",
          "description": "Datetime columns removed from model features. Include timestamp_column here when it should not be a predictor.",
          "example": ["observation_time"]
        },
        {
          "path": "data.drop_constant",
          "type": "boolean",
          "required": "No",
          "default": true,
          "allowed": [true, false],
          "description": "Removes predictors with only one observed value.",
          "example": true
        },
        {
          "path": "data.max_cardinality",
          "type": "positive integer or null",
          "required": "No",
          "default": null,
          "allowed": "Positive integer",
          "description": "Drops categorical columns whose unique-value count exceeds the threshold.",
          "example": 100
        },
        {
          "path": "data.keep_dataframe",
          "type": "boolean",
          "required": "No",
          "default": true,
          "allowed": [true, false],
          "description": "Keeps raw columns for split-fitted preprocessing. True is the recommended leakage-safe path.",
          "example": true
        }
      ]
    },
    {
      "name": "Dataset loader dependency",
      "fields": [
        {
          "path": "dataset_loader.module",
          "type": "string",
          "required": "No",
          "default": "dataset_loader",
          "allowed": "Importable module name",
          "description": "Companion loader module imported at startup.",
          "example": "dataset_loader"
        },
        {
          "path": "dataset_loader.module_path",
          "type": "string path or null",
          "required": "No",
          "default": null,
          "allowed": "Compatible Python file",
          "description": "Explicit loader file path. Relative paths resolve from the source JSON.",
          "example": "../loaders/site_loader.py"
        },
        {
          "path": "dataset_loader.required_functions",
          "type": "array of strings",
          "required": "Yes for a custom loader",
          "default": ["prepare_dataset", "_load_dataframe"],
          "allowed": "Callable names exposed by the loader",
          "description": "Startup interface contract checked before execution.",
          "example": ["prepare_dataset", "_load_dataframe"]
        }
      ]
    },
    {
      "name": "Sampling and splitting",
      "fields": [
        {
          "path": "sampling.strategy",
          "type": "string",
          "required": "No",
          "default": "original_prevalence",
          "allowed": ["original_prevalence", "balanced", "custom_prevalence"],
          "description": "Target class-1 prevalence for sampled subsets.",
          "example": "original_prevalence"
        },
        {
          "path": "sampling.class1_prevalence",
          "type": "number",
          "required": "Only for custom_prevalence",
          "default": null,
          "allowed": "Strictly between 0 and 1",
          "description": "Requested class-1 prevalence when custom sampling is selected.",
          "example": 0.35
        },
        {
          "path": "splitting.strategy",
          "type": "string",
          "required": "No",
          "default": "auto",
          "allowed": ["auto", "stratified", "stratified_group", "temporal"],
          "description": "Outer and inner partition family. Auto uses groups when supplied.",
          "example": "stratified_group"
        },
        {
          "path": "splitting.group_aware",
          "type": "boolean",
          "required": "No",
          "default": true,
          "allowed": [true, false],
          "description": "Allows auto mode to select grouped splitting when groups are available.",
          "example": true
        },
        {
          "path": "splitting.require_groups",
          "type": "boolean",
          "required": "No",
          "default": false,
          "allowed": [true, false],
          "description": "Fails preflight if the configuration requires groups but none are loaded.",
          "example": true
        },
        {
          "path": "splitting.strict",
          "type": "boolean",
          "required": "No",
          "default": true,
          "allowed": [true, false],
          "description": "Enforces partition feasibility and configured split-quality constraints.",
          "example": true
        },
        {
          "path": "splitting.candidate_splits",
          "type": "positive integer",
          "required": "No",
          "default": 256,
          "allowed": "1 or greater",
          "description": "Number of deterministic candidate partitions evaluated where applicable.",
          "example": 256
        },
        {
          "path": "splitting.min_class_count_per_partition",
          "type": "positive integer",
          "required": "No",
          "default": 2,
          "allowed": "1 or greater",
          "description": "Minimum number of rows from each class in every required partition.",
          "example": 2
        },
        {
          "path": "splitting.max_prevalence_deviation",
          "type": "number or null",
          "required": "No",
          "default": null,
          "allowed": "Non-negative number",
          "description": "Optional maximum absolute deviation from target class prevalence.",
          "example": 0.05
        },
        {
          "path": "splitting.max_row_fraction_deviation",
          "type": "number or null",
          "required": "No",
          "default": null,
          "allowed": "Non-negative number",
          "description": "Optional maximum deviation from the requested train/test row fraction.",
          "example": 0.05
        },
        {
          "path": "splitting.shuffle_rows_within_partitions",
          "type": "boolean",
          "required": "No",
          "default": true,
          "allowed": [true, false],
          "description": "Deterministically shuffles rows after membership is established.",
          "example": true
        },
        {
          "path": "splitting.temporal_window",
          "type": "string",
          "required": "Temporal splitting only",
          "default": "latest",
          "allowed": ["latest", "earliest"],
          "description": "Chooses which end of the ordered dataset supplies the sampled window.",
          "example": "latest"
        },
        {
          "path": "splitting.temporal_gap_rows",
          "type": "non-negative integer",
          "required": "No",
          "default": 0,
          "allowed": "0 or greater",
          "description": "Number of ordered rows excluded between training and test partitions.",
          "example": 0
        },
        {
          "path": "splitting.temporal_enforce_group_disjoint",
          "type": "boolean",
          "required": "No",
          "default": false,
          "allowed": [true, false],
          "description": "Also enforces group separation in a temporal split when groups are supplied.",
          "example": true
        }
      ]
    },
    {
      "name": "Preprocessing",
      "fields": [
        {
          "path": "preprocessing.mode",
          "type": "string",
          "required": "No",
          "default": "auto",
          "allowed": "auto or a supported preserved-engine mode",
          "description": "Selects preprocessing while retaining train-only fitting.",
          "example": "auto"
        },
        {
          "path": "preprocessing.numeric_imputation",
          "type": "string",
          "required": "No",
          "default": "median",
          "allowed": "Supported SimpleImputer strategy",
          "description": "Train-fitted numeric missing-value strategy.",
          "example": "median"
        },
        {
          "path": "preprocessing.categorical_imputation_value",
          "type": "scalar",
          "required": "No",
          "default": "__MISSING__",
          "allowed": "Non-sensitive replacement value",
          "description": "Train-fitted categorical missing-value replacement.",
          "example": "__MISSING__"
        },
        {
          "path": "preprocessing.categorical_encoding",
          "type": "string",
          "required": "No",
          "default": "onehot",
          "allowed": ["onehot"],
          "description": "Categorical encoding used by the conventional-model preprocessing path.",
          "example": "onehot"
        },
        {
          "path": "preprocessing.onehot_min_frequency",
          "type": "integer, fraction, or null",
          "required": "No",
          "default": null,
          "allowed": "Values accepted by scikit-learn OneHotEncoder",
          "description": "Optional threshold for grouping infrequent categories.",
          "example": 5
        },
        {
          "path": "preprocessing.onehot_max_categories",
          "type": "positive integer or null",
          "required": "No",
          "default": null,
          "allowed": "Positive integer",
          "description": "Optional maximum encoded categories per feature.",
          "example": 20
        },
        {
          "path": "preprocessing.max_output_features",
          "type": "positive integer or null",
          "required": "No",
          "default": null,
          "allowed": "Positive integer",
          "description": "Optional safety limit for the prepared feature matrix.",
          "example": 1000
        }
      ]
    },
    {
      "name": "Models and hyperparameter optimisation",
      "fields": [
        {
          "path": "optuna.direction",
          "type": "string",
          "required": "No",
          "default": "maximize",
          "allowed": ["maximize"],
          "description": "Direction of the validation-AUROC objective.",
          "example": "maximize"
        },
        {
          "path": "optuna.max_trials",
          "type": "positive integer",
          "required": "No",
          "default": 50,
          "allowed": "1 or greater",
          "description": "Default maximum completed-trial target. Runtime budgets may restrict eligible trials.",
          "example": 50
        },
        {
          "path": "models.<model>.enabled",
          "type": "boolean",
          "required": "No",
          "default": "Model-specific",
          "allowed": [true, false],
          "description": "Global model availability before scenario-specific selection.",
          "example": true
        },
        {
          "path": "models.<model>.max_trials",
          "type": "positive integer",
          "required": "No",
          "default": "optuna.max_trials",
          "allowed": "1 or greater",
          "description": "Model-specific maximum trial count.",
          "example": 50
        },
        {
          "path": "models.<model>.fixed_params",
          "type": "object",
          "required": "No",
          "default": {},
          "allowed": "Parameters supported by the installed estimator version",
          "description": "Fixed estimator parameters applied outside the search space.",
          "example": {
            "random_state": 2025
          }
        },
        {
          "path": "models.<model>.search_space",
          "type": "object",
          "required": "Tuned models",
          "default": "Inherited model definition",
          "allowed": "Configured int, float, categorical, or boolean parameter rules",
          "description": "JSON-defined Optuna search space. Do not change it when reproducing an archived study.",
          "example": {
            "max_depth": {
              "type": "int",
              "low": 2,
              "high": 8
            }
          }
        },
        {
          "path": "models.XGBoost.execution.device",
          "type": "string",
          "required": "No",
          "default": "auto",
          "allowed": ["auto", "cpu", "cuda"],
          "description": "Requested XGBoost execution device.",
          "example": "auto"
        },
        {
          "path": "models.CatBoost.execution.device",
          "type": "string",
          "required": "No",
          "default": "auto",
          "allowed": ["auto", "cpu", "cuda"],
          "description": "Requested CatBoost execution device.",
          "example": "auto"
        },
        {
          "path": "models.<model>.execution.require_requested_device",
          "type": "boolean",
          "required": "No",
          "default": false,
          "allowed": [true, false],
          "description": "Fails preflight instead of falling back when the requested device is unavailable.",
          "example": true
        }
      ]
    },
    {
      "name": "Scenarios and runtime budgets",
      "fields": [
        {
          "path": "replace_scenarios",
          "type": "boolean",
          "required": "No",
          "default": false,
          "allowed": [true, false],
          "description": "Replaces inherited scenarios instead of merging them.",
          "example": true
        },
        {
          "path": "scenarios.<name>.semantic_role",
          "type": "string",
          "required": "Recommended",
          "default": null,
          "allowed": "Descriptive role such as no_budget_control or tuned_ml_runtime_reference",
          "description": "Reader-facing scenario interpretation used in manifests and plots.",
          "example": "no_budget_control"
        },
        {
          "path": "scenarios.<name>.enabled_models",
          "type": "array of strings",
          "required": "Yes",
          "default": "Inherited enabled models",
          "allowed": ["L-SLR", "Augmented_SLR", "RandomForest", "XGBoost", "CatBoost", "TabPFN"],
          "description": "Exact core models expected for every iteration in the scenario.",
          "example": ["RandomForest", "XGBoost", "TabPFN"]
        },
        {
          "path": "scenarios.<name>.budgeting.enabled",
          "type": "boolean",
          "required": "Yes",
          "default": true,
          "allowed": [true, false],
          "description": "Enables or disables runtime-budget comparison for the scenario.",
          "example": false
        },
        {
          "path": "scenarios.<name>.budget_reference_model",
          "type": "model name or null",
          "required": "Budgeted scenarios",
          "default": null,
          "allowed": "One enabled core model",
          "description": "Model whose scientific runtime definition supplies the reference budget.",
          "example": "XGBoost"
        },
        {
          "path": "scenarios.<name>.budgeting.cap_untuned_competitors",
          "type": "boolean",
          "required": "No",
          "default": true,
          "allowed": [true, false],
          "description": "Applies the configured hard deadline to eligible non-tuned competitors.",
          "example": true
        },
        {
          "path": "budgeting.non_tuned_reference_runtime_basis",
          "type": "string",
          "required": "Non-tuned reference scenarios",
          "default": "reference_execution_runtime",
          "allowed": ["reference_execution_runtime"],
          "description": "Preserved execution-runtime basis for a reference without conventional Optuna HPO.",
          "example": "reference_execution_runtime"
        },
        {
          "path": "scenarios.<name>.model_overrides",
          "type": "object",
          "required": "No",
          "default": {},
          "allowed": "Model-keyed configuration overrides",
          "description": "Scenario-specific model settings merged without changing unrelated scenarios.",
          "example": {}
        },
        {
          "path": "scenarios.<name>.external_runtime_budget_seconds",
          "type": "positive number or null",
          "required": "External-budget scenarios only",
          "default": null,
          "allowed": "Positive stopwatch seconds",
          "description": "Explicit persisted budget used only when the study design calls for an external reference.",
          "example": 300
        }
      ]
    },
    {
      "name": "TabPFN execution, context, and auxiliary comparators",
      "fields": [
        {
          "path": "models.TabPFN.execution.path",
          "type": "string",
          "required": "No",
          "default": "auto",
          "allowed": ["auto", "local", "cloud"],
          "description": "Selects local TabPFN or the external cloud/client implementation.",
          "example": "local"
        },
        {
          "path": "models.TabPFN.execution.local_device",
          "type": "string",
          "required": "Local execution only",
          "default": "auto",
          "allowed": ["auto", "cpu", "cuda"],
          "description": "Requested local TabPFN device.",
          "example": "cuda"
        },
        {
          "path": "models.TabPFN.local_tabpfn_budget.model_version",
          "type": "string",
          "required": "No",
          "default": "auto",
          "allowed": "Version supported by the installed TabPFN package",
          "description": "Recorded local TabPFN model/version selection.",
          "example": "auto"
        },
        {
          "path": "models.TabPFN.local_tabpfn_budget.model_path",
          "type": "string",
          "required": "No",
          "default": "auto",
          "allowed": "auto or a compatible local model path",
          "description": "Checkpoint/model location for local execution.",
          "example": "auto"
        },
        {
          "path": "models.TabPFN.local_tabpfn_budget.context_strategy.strategy",
          "type": "string",
          "required": "Local TabPFN",
          "default": "adaptive",
          "allowed": ["fixed", "adaptive", "full"],
          "description": "Fixed uses one candidate, adaptive searches under the budget, and full uses all outer-training rows.",
          "example": "adaptive"
        },
        {
          "path": "models.TabPFN.local_tabpfn_budget.context_strategy.rows",
          "type": "positive integer",
          "required": "Fixed row-count rule only",
          "default": null,
          "allowed": "Feasible positive row count",
          "description": "Configured context size for a fixed context.",
          "example": 500
        },
        {
          "path": "models.TabPFN.local_tabpfn_budget.context_strategy.fraction",
          "type": "number",
          "required": "Fractional context rule only",
          "default": null,
          "allowed": "Strictly between 0 and 1",
          "description": "Context fraction resolved against the selected denominator.",
          "example": 0.2
        },
        {
          "path": "models.TabPFN.local_tabpfn_budget.context_strategy.fraction_denominator",
          "type": "string",
          "required": "When fraction is used",
          "default": "total_sample",
          "allowed": ["total_sample", "outer_train"],
          "description": "Denominator used to translate a fraction into context rows.",
          "example": "outer_train"
        },
        {
          "path": "auxiliary_comparators[].id",
          "type": "string",
          "required": "Each comparator",
          "default": null,
          "allowed": "Unique stable identifier",
          "description": "Separate execution and artifact identity for the comparator.",
          "example": "Plain_Local_TabPFN"
        },
        {
          "path": "auxiliary_comparators[].base_model",
          "type": "model name",
