{
  "extends": "base_config.example.json",
  "enabled": false,
  "template_only": false,
  "experiment_name": "V13_Tiny_Tuned_Reference_QC",
  "iterations": 1,
  "sample_sizes": [
    80
  ],
  "replace_scenarios": true,
  "scenarios": {
    "Arbitrary_Tuned_Reference_QC": {
      "semantic_role": "tuned_ml_runtime_reference",
      "budgeting": {
        "enabled": true
      },
      "budget_reference_model": "RandomForest",
      "enabled_models": [
        "RandomForest"
      ],
      "model_overrides": {}
    }
  },
  "optuna": {
    "direction": "maximize",
    "max_trials": 1
  },
  "models": {
    "RandomForest": {
      "enabled": true,
      "max_trials": 1,
      "replace_search_space": true,
      "search_space": {
        "n_estimators": {
          "type": "int",
          "low": 5,
          "high": 8
        },
        "max_depth": {
          "type": "int",
          "low": 2,
          "high": 4
        },
        "max_features": {
          "type": "float",
          "low": 0.5,
          "high": 1.0
        },
        "min_samples_leaf": {
          "type": "int",
          "low": 1,
          "high": 3
        }
      },
      "default_params": {
        "n_estimators": 5,
        "max_depth": 3,
        "max_features": 1.0,
        "min_samples_leaf": 1
      }
    }
  },
  "cpu_parallelism": {
    "policy": "max_available",
    "threads": "auto",
    "prevent_nested_oversubscription": true,
    "allow_oversubscription": false
  },
  "cpu_monitoring": {
    "enabled": true,
    "show_console": false,
    "sampling_interval_seconds": 0.05,
    "save_timeseries": true
  },
  "energy": {
    "enabled": false,
    "required": false,
    "allow_unavailable": true,
    "tracking_mode": "process"
  },
  "outputs": {
    "root": "./.v13_qc_runs",
    "save_fitted_models": false,
    "save_predictions_parquet": true,
    "save_predictions_npz": true,
    "save_group_ids": true,
    "artifact_index": true
  },
  "plots": {
    "enabled": true,
    "save_html": false,
    "save_png": true,
    "save_svg": false,
    "show_figures": false,
    "dpi": 72,
    "calibration_bins": 5,
    "runtime_axis_scale": "linear"
  },
  "execution": {
    "on_model_error": "raise",
    "on_iteration_error": "raise",
    "deterministic_torch": false
  }
}
