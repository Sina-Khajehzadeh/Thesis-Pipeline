{
  "extends": "base_config.example.json",
  "enabled": false,
  "template_only": true,
  "experiment_name": "Replace_With_Experiment_Name",
  "iterations": 5,
  "base_seed": 2025,
  "sample_sizes": [
    100,
    "full"
  ],
  "data": {
    "source": "data/replace_with_dataset.csv",
    "dataset_identifier": "replace_with_dataset_version",
    "read_kwargs": {},
    "target": "replace_with_binary_outcome",
    "positive_label": 1,
    "group_column": null,
    "timestamp_column": null,
    "feature_columns": null,
    "drop_columns": [
      "replace_with_identifier_or_leakage_column"
    ],
    "datetime_columns": [],
    "drop_constant": true,
    "max_cardinality": null,
    "keep_dataframe": true
  },
  "dataset_loader": {
    "module": "dataset_loader",
    "module_path": null,
    "required_functions": [
      "prepare_dataset",
      "_load_dataframe"
    ]
  },
  "sampling": {
    "strategy": "original_prevalence"
  },
  "splitting": {
    "strategy": "stratified",
    "group_aware": false,
    "require_groups": false,
    "strict": true,
    "candidate_splits": 256,
    "min_class_count_per_partition": 2,
    "shuffle_rows_within_partitions": true,
    "temporal_window": "latest",
    "temporal_gap_rows": 0,
    "temporal_enforce_group_disjoint": false
  },
  "preprocessing": {
    "mode": "auto",
    "numeric_imputation": "median",
    "categorical_imputation_value": "__MISSING__",
    "categorical_encoding": "onehot",
    "onehot_min_frequency": null,
    "onehot_max_categories": null,
    "max_output_features": null
  },
  "optuna": {
    "direction": "maximize",
    "max_trials": 50
  },
  "models": {
    "TabPFN": {
      "enabled": true,
      "execution": {
        "path": "local",
        "local_device": "auto",
        "require_requested_device": false
      },
      "local_tabpfn_budget": {
        "model_version": "auto",
        "model_path": "auto",
        "fit_mode": "fit_preprocessors",
        "n_estimators": 1,
        "context_strategy": {
          "strategy": "adaptive",
          "fraction": 0.2,
          "fraction_denominator": "outer_train"
        },
        "minimum_context_budget_multiplier_enabled": true
      }
    },
    "L-SLR": {
      "enabled": true
    },
    "Augmented_SLR": {
      "enabled": true
    },
    "RandomForest": {
      "enabled": true
    },
    "XGBoost": {
      "enabled": true,
      "execution": {
        "device": "auto",
        "require_requested_device": false
      }
    },
    "CatBoost": {
      "enabled": true,
      "execution": {
        "device": "auto",
        "require_requested_device": false
      }
    }
  },
  "replace_scenarios": true,
  "scenarios": {
    "Replace_With_Scenario_Name": {
      "semantic_role": "no_budget_control",
      "budgeting": {
        "enabled": false
      },
      "budget_reference_model": null,
      "enabled_models": [
        "L-SLR",
        "Augmented_SLR",
        "RandomForest",
        "XGBoost",
        "CatBoost",
        "TabPFN"
      ],
      "model_overrides": {}
    }
  },
  "auxiliary_comparators": [],
  "cpu_parallelism": {
    "policy": "max_available",
    "threads": "auto",
    "prevent_nested_oversubscription": true,
    "allow_oversubscription": false,
    "environment": {}
  },
  "cpu_monitoring": {
    "enabled": true,
    "show_console": true,
    "sampling_interval_seconds": 5,
    "save_timeseries": true
  },
  "energy": {
    "enabled": false,
    "required": false,
    "allow_unavailable": true,
    "tracking_mode": "process",
    "save_client_side_cloud_energy": true,
    "save_codecarbon_metadata": true
  },
  "outputs": {
    "root": "./V14_Experiments",
    "save_fitted_models": false,
    "save_predictions_parquet": true,
    "save_predictions_npz": true,
    "save_group_ids": true,
    "artifact_index": true
  },
  "plots": {
    "enabled": true,
    "save_html": false,
    "save_png": true,
    "save_svg": true,
    "show_figures": false,
    "dpi": 180,
    "calibration_bins": 10,
    "runtime_axis_scale": "linear",
    "cross_scenario_runtime_sample": "max",
    "scenario_roles": {},
    "plot_specs": []
  },
  "execution": {
    "on_model_error": "continue",
    "on_iteration_error": "continue",
    "deterministic_torch": false
  }
}
